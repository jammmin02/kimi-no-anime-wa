# =========================================================================
# 「君のアニメは」環境変数サンプル
# 実際の値は絶対にコミットしないこと。このファイルをコピーして .env を作成し、
# 各自の値を設定する。
#
#   cp .env.example .env
# =========================================================================

# --- アプリ実行環境 ---
NODE_ENV=development
# アプリがローカルで動くベース URL(メール内リンク生成などで使用予定)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- PostgreSQL (docker-compose.yml のコンテナ設定と対応させること) ---
POSTGRES_USER=your_postgres_user
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=kimi_no_anime_wa
POSTGRES_PORT=5432

# アプリ(ORM)から DB に接続する際の接続文字列。
# 上記の POSTGRES_* の値と一致させること。
DATABASE_URL="postgresql://your_postgres_user:your_postgres_password@localhost:5432/kimi_no_anime_wa?schema=public"

# --- 認証 ---
# メール+パスワード方式の自前認証で使用する JWT 署名用シークレット。
# 本番では十分に長いランダム文字列を発行して設定すること(ソーシャルログインは未実装)。
JWT_SECRET=replace_with_a_long_random_secret

# --- 外部 API ---
# Anthropic Claude API キー(自然言語検索・チャットボット・レビュー要約などで使用予定)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

# AniList GraphQL API エンドポイント(作品データのバッチ同期に使用予定)
ANILIST_API_URL=https://graphql.anilist.co

# --- AniList バッチ同期(P0-3, npm run sync:anilist) ---
# 同期対象の種別(カンマ区切り。ANIME / MANGA)
ANILIST_SYNC_TYPES=ANIME,MANGA
# 取得順のソート(AniList の MediaSort 値。例: TRENDING_DESC, POPULARITY_DESC)
ANILIST_SYNC_SORT=TRENDING_DESC
# 1ページあたりの取得件数(AniList 側の上限は50)
ANILIST_SYNC_PER_PAGE=50
# 1回のバッチ実行で種別ごとに取得する最大ページ数
ANILIST_SYNC_MAX_PAGES=3
# リクエスト間の最小間隔(ms)。AniList のレートリミット(基準は分あたり90回、
# 一時的に分あたり30回の場合がある)を守るための値。デフォルトは分あたり30回でも
# 安全な 2000ms。
ANILIST_MIN_INTERVAL_MS=2000

# LibreTranslate サーバーの URL(レビュー自動翻訳機能で使用予定。無料/OSS の翻訳エンジン)
LIBRETRANSLATE_URL=http://localhost:5000
