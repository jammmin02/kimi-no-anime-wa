# =========================================================================
# 「君のアニメは」本番環境用の環境変数サンプル。
#
# 実際の値は絶対にコミットしないこと。EC2 上でこのファイルをコピーして
# `.env.production` を作成し、各自の値を設定する。
#
#   cp .env.production.example .env.production
#
# `.env.production` は docker-compose.prod.yml の各サービスから
# `env_file:` で読み込まれる。
# =========================================================================

# --- アプリ実行環境 ---
NODE_ENV=production
# アプリの公開 URL(メール内リンク生成などで使用予定)。ドメインが決まったら変更する。
NEXT_PUBLIC_APP_URL=http://your-ec2-public-ip-or-domain

# --- ホスト側の公開ポート(docker-compose.prod.yml の ports: で使用) ---
# Next.js アプリを公開する host 側ポート。80 番のまま運用するか、
# 前段に nginx 等を置く場合は変更する。
APP_PORT=80
# LibreTranslate を外部公開する必要が無ければ、セキュリティグループ側で
# このポートを塞いでおくこと(app コンテナからは内部ネットワーク経由で到達できる)。
LIBRETRANSLATE_PORT=5000

# --- PostgreSQL ---
# db サービス(local-db profile)をこのホストで動かす場合に使用する接続情報。
# RDS に移行する場合、POSTGRES_* は使わなくなり、DATABASE_URL だけを
# RDS のエンドポイントに向ければよい(アプリ側のコード変更は不要)。
POSTGRES_USER=replace_with_a_strong_username
POSTGRES_PASSWORD=replace_with_a_strong_password
POSTGRES_DB=kimi_no_anime_wa

# アプリ(ORM)から DB に接続する際の接続文字列。
# - db サービスをこのホストで使う場合: ホスト名は docker-compose 内のサービス名 `db` にする
#     DATABASE_URL="postgresql://replace_with_a_strong_username:replace_with_a_strong_password@db:5432/kimi_no_anime_wa?schema=public"
# - RDS に移行した場合: ホスト名を RDS エンドポイントに置き換える
#     DATABASE_URL="postgresql://<user>:<password>@<rds-endpoint>:5432/kimi_no_anime_wa?schema=public"
DATABASE_URL="postgresql://replace_with_a_strong_username:replace_with_a_strong_password@db:5432/kimi_no_anime_wa?schema=public"

# --- 認証 ---
# メール+パスワード方式の自前認証で使用する JWT 署名用シークレット。
# 本番では十分に長いランダム文字列を発行して設定すること(例: openssl rand -base64 48)。
JWT_SECRET=replace_with_a_long_random_secret

# --- 外部 API ---
# Anthropic Claude API キー(自然言語検索・チャットボット・レビュー要約などで使用予定)
ANTHROPIC_API_KEY=replace_with_your_anthropic_api_key

# AniList GraphQL API エンドポイント(作品データのバッチ同期に使用予定)
ANILIST_API_URL=https://graphql.anilist.co

# --- AniList バッチ同期(P0-3, npm run sync:anilist。cron から定期実行する) ---
ANILIST_SYNC_TYPES=ANIME,MANGA
ANILIST_SYNC_SORT=TRENDING_DESC
ANILIST_SYNC_PER_PAGE=50
ANILIST_SYNC_MAX_PAGES=3
# レートリミット(基準は分あたり90回、一時的に分あたり30回の場合がある)を守るための
# リクエスト間隔(ms)。
ANILIST_MIN_INTERVAL_MS=2000

# LibreTranslate サーバーの URL。
# docker-compose 内では localhost ではなく、サービス名 `libretranslate` で到達する。
LIBRETRANSLATE_URL=http://libretranslate:5000
